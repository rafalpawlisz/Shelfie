# Kotlin's project-local compiler session data.
.kotlin

# Firebase project config — per-developer, not for a public repo. CI rebuilds
# it from a secret, or falls back to .github/ci/google-services.json.
app/google-services.json

# Signing material and build outputs: never in the repo, and the ignore is
# cheap insurance for a public one.
*.jks
*.keystore
# Keystore path and passwords for local release builds; CI passes them as env.
keystore.properties
*.apk
*.aab
*.hprof

# The rules tests: npm dependencies and whatever the emulator logs beside them.
firestore-tests/node_modules
*-debug.log
npm-debug.log*
/.firebase
# Holds the local JDK name, so it differs per machine.
/.idea/misc.xml
