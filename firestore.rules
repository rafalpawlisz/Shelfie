rules_version = '2';

// Shelfie household model. Everything not explicitly allowed is denied.
//
// households/{hid}   { name, members: {uid: true}, inviteCode, createdAt, createdBy }
// users/{uid}        { householdId }
// inviteCodes/{code} { householdId }   — code → household index for joining
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      // Each user reads and writes only their own pointer document.
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      function isMember() {
        return resource.data.members[request.auth.uid] == true;
      }

      // The whole diff between old and new doc touches only these fields.
      function changesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(fields);
      }

      // The members map changed for the caller's uid and nobody else.
      function membersDiffOnlySelf() {
        return request.resource.data.members.diff(resource.data.members)
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      // Creating a household: the creator is its sole member.
      allow create: if signedIn()
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;

      allow read: if signedIn() && isMember();

      allow update: if signedIn() && (
        // Joining: a non-member may add exactly their own uid, nothing else.
        (
          !(request.auth.uid in resource.data.members)
          && changesOnly(['members'])
          && membersDiffOnlySelf()
          && request.resource.data.members[request.auth.uid] == true
        )
        // Leaving: a member may remove exactly their own uid, nothing else.
        || (
          isMember()
          && changesOnly(['members'])
          && membersDiffOnlySelf()
          && !(request.auth.uid in request.resource.data.members)
        )
        // Members may rename the household.
        || (isMember() && changesOnly(['name']))
        // Members stamp lastActiveAt once per sync session (housekeeping
        // signal for the project owner; nothing in the app reads it).
        || (isMember() && changesOnly(['lastActiveAt']))
      );

      // A sole member may delete their own household. The membership check is
      // not redundant: hasOnly() is trivially true for an empty map, so
      // without it any signed-in user could delete a memberless household —
      // and those are kept on purpose so they can be rejoined by code.
      allow delete: if signedIn()
        && resource.data.members.keys().hasOnly([request.auth.uid])
        && resource.data.members[request.auth.uid] == true;

      // Synced pantry data (products/lists/items/barcodes/listOrder): any
      // member reads and writes anything under their household; everyone
      // else is locked out.
      match /{collection}/{docId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/households/$(hid))
               .data.members[request.auth.uid] == true;
      }
    }

    match /inviteCodes/{code} {
      // Knowing the code is the capability to resolve it — but only resolve:
      // a targeted get, never a listing.
      allow get: if signedIn();
      allow list: if false;

      // Created in the same batch as the household (getAfter sees the batch
      // result); the author must end up a member of the pointed household.
      //
      // The document id must also BE that household's inviteCode. Without that
      // tie a member could mint extra codes of their own choosing — invisible
      // to everyone else, since members cannot list codes either, and
      // unrevokable because the household's inviteCode field is immutable —
      // and quietly let themselves back in after leaving.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId'])
        && getAfter(
             /databases/$(database)/documents/households/$(request.resource.data.householdId)
           ).data.members[request.auth.uid] == true
        && getAfter(
             /databases/$(database)/documents/households/$(request.resource.data.householdId)
           ).data.inviteCode == code;

      // A member of the pointed household may delete its code (pre-state read,
      // so it also works when the household goes in the same batch).
      //
      // A code whose household no longer exists may be cleared by anyone: such
      // a code resolves to nothing, every membership check on it fails
      // forever, so it would otherwise be undeletable — and it turns dangerous
      // the day that household id gets reused.
      allow delete: if signedIn() && (
        !exists(/databases/$(database)/documents/households/$(resource.data.householdId))
        || get(
             /databases/$(database)/documents/households/$(resource.data.householdId)
           ).data.members[request.auth.uid] == true
      );
    }
  }
}
