rules_version = '2';

// Shelfie household model. Everything not explicitly allowed is denied.
//
// households/{hid}   { name, members: {uid: true}, inviteCode, createdAt,
//                      createdBy, lastActiveAt, memberActivity: {uid: time},
//                      memberVersions: {uid: "0.2.1 (6)"} }
// users/{uid}        { householdId }
// inviteCodes/{code} { householdId }   — code → household index for joining
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      // Each user reads and writes only their own pointer document.
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      function isMember() {
        return resource.data.members[request.auth.uid] == true;
      }

      // The whole diff between old and new doc touches only these fields.
      function changesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(fields);
      }

      // The members map changed for the caller's uid and nobody else.
      function membersDiffOnlySelf() {
        return request.resource.data.members.diff(resource.data.members)
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      function touches(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
      }

      // The field carries the time this write is served, and nothing else. Both
      // activity stamps are housekeeping signals read by a human much later, so
      // a backdated or misspelled value is worse than no value: it makes a live
      // household look abandoned. The presence check guards the read, like in
      // stampsOwnActivityOnly() below.
      function stampsNow(field) {
        return field in request.resource.data
          && request.resource.data[field] == request.time;
      }

      // The memberActivity map gained exactly one entry — the caller's own,
      // set to the time this write is served. The presence check comes first
      // on purpose: without it, an update that drops the whole map reads a
      // missing property and fails as an evaluation error rather than a plain
      // denial, which is noise in the logs for a case we can just answer.
      function stampsOwnActivityOnly() {
        return 'memberActivity' in request.resource.data
          && request.resource.data.memberActivity
               .diff(resource.data.get('memberActivity', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberActivity[request.auth.uid] == request.time;
      }

      // The memberActivity map lost exactly the caller's own entry and kept
      // everyone else's. Leaving takes the stamp along: a former member may not
      // touch the map at all (both activity clauses require membership), so
      // whatever is left behind stays there forever — dead weight in the very
      // map that exists to point out dead memberships.
      function dropsOwnActivityOnly() {
        return request.resource.data.get('memberActivity', {})
               .diff(resource.data.get('memberActivity', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.get('memberActivity', {}));
      }

      // The memberVersions map changed for the caller's own key only, to a
      // string of a plausible length. Same shape as the activity stamp, and
      // constrained for the same reason: a member who could write anyone's
      // entry could make another phone look up to date when it is not, which
      // defeats the only purpose the field has.
      function setsOwnVersionOnly() {
        return 'memberVersions' in request.resource.data
          && request.resource.data.memberVersions
               .diff(resource.data.get('memberVersions', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberVersions[request.auth.uid] is string
          && request.resource.data.memberVersions[request.auth.uid].size() <= 32;
      }

      // The mirror of the above for leaving, matching dropsOwnActivityOnly().
      function dropsOwnVersionOnly() {
        return request.resource.data.get('memberVersions', {})
               .diff(resource.data.get('memberVersions', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.get('memberVersions', {}));
      }

      // Creating a household: the creator is its sole member.
      allow create: if signedIn()
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;

      allow read: if signedIn() && isMember();

      allow update: if signedIn() && (
        // Joining: a non-member may add exactly their own uid, nothing else.
        (
          !(request.auth.uid in resource.data.members)
          && changesOnly(['members'])
          && membersDiffOnlySelf()
          && request.resource.data.members[request.auth.uid] == true
        )
        // Leaving: a member may remove exactly their own uid, and with it their
        // own activity stamp — nothing else, and nobody else's.
        || (
          isMember()
          && changesOnly(['members', 'memberActivity', 'memberVersions'])
          && membersDiffOnlySelf()
          && !(request.auth.uid in request.resource.data.members)
          && (!touches('memberActivity') || dropsOwnActivityOnly())
          && (!touches('memberVersions') || dropsOwnVersionOnly())
        )
        // Members may rename the household — to an actual name. changesOnly()
        // counts a removed key as affected, so without the type and length
        // check a "rename" could delete the field or set it to a map.
        || (
          isMember()
          && changesOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
        )
        // Members stamp lastActiveAt, their own memberActivity entry and the
        // version they are running, once per sync session (housekeeping
        // signals for the project owner; nothing in the app reads them).
        //
        // Every half is constrained: a member may only touch their own entry,
        // and the time only to the server's clock. Otherwise the fields meant
        // to identify dead or stale members would let a live one forge
        // activity for them — or backdate someone else into looking prunable.
        || (
          isMember()
          && changesOnly(['lastActiveAt', 'memberActivity', 'memberVersions'])
          && (!touches('lastActiveAt') || stampsNow('lastActiveAt'))
          && (!touches('memberActivity') || stampsOwnActivityOnly())
          && (!touches('memberVersions') || setsOwnVersionOnly())
        )
      );

      // A sole member may delete their own household. The membership check is
      // not redundant: hasOnly() is trivially true for an empty map, so
      // without it any signed-in user could delete a memberless household —
      // and those are kept on purpose so they can be rejoined by code.
      allow delete: if signedIn()
        && resource.data.members.keys().hasOnly([request.auth.uid])
        && resource.data.members[request.auth.uid] == true;

      // Synced pantry data (products/lists/items/barcodes/listOrder/
      // oneOffSuggestions): any member reads and writes anything under their
      // household; everyone else is locked out. The wildcard is deliberate —
      // a new synced table is a schema decision, not a security one, and
      // needing a rules deploy to ship one would be a trap worth avoiding.
      match /{collection}/{docId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/households/$(hid))
               .data.members[request.auth.uid] == true;
      }
    }

    match /inviteCodes/{code} {
      // Knowing the code is the capability to resolve it — but only resolve:
      // a targeted get, never a listing.
      allow get: if signedIn();
      allow list: if false;

      // Created in the same batch as the household (getAfter sees the batch
      // result); the author must end up a member of the pointed household.
      //
      // The document id must also BE that household's inviteCode. Without that
      // tie a member could mint extra codes of their own choosing — invisible
      // to everyone else, since members cannot list codes either, and
      // unrevokable because the household's inviteCode field is immutable —
      // and quietly let themselves back in after leaving.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId'])
        && getAfter(
             /databases/$(database)/documents/households/$(request.resource.data.householdId)
           ).data.members[request.auth.uid] == true
        && getAfter(
             /databases/$(database)/documents/households/$(request.resource.data.householdId)
           ).data.inviteCode == code;

      // A member of the pointed household may delete its code (pre-state read,
      // so it also works when the household goes in the same batch).
      //
      // A code whose household no longer exists may be cleared by anyone: such
      // a code resolves to nothing, every membership check on it fails
      // forever, so it would otherwise be undeletable — and it turns dangerous
      // the day that household id gets reused.
      allow delete: if signedIn() && (
        !exists(/databases/$(database)/documents/households/$(resource.data.householdId))
        || get(
             /databases/$(database)/documents/households/$(resource.data.householdId)
           ).data.members[request.auth.uid] == true
      );
    }
  }
}
