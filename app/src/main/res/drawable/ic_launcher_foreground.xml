<?xml version="1.0" encoding="utf-8"?>
<!-- Camera lens with a jar at its centre ("shelf + selfie"). Single colour so
     the same drawable doubles as the monochrome (themed icon) layer. Content
     sits within the adaptive-icon safe zone (central ~66dp of the 108 grid). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer lens ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F4EEE1"
        android:strokeWidth="6"
        android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0" />

    <!-- inner ring (faint) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F4EEE1"
        android:strokeWidth="2"
        android:strokeAlpha="0.55"
        android:pathData="M33,54 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />

    <!-- jar lid -->
    <path
        android:fillColor="#F4EEE1"
        android:pathData="M46,44 v-2 a2,2 0 0 1 2,-2 h12 a2,2 0 0 1 2,2 v2 z" />

    <!-- jar body -->
    <path
        android:fillColor="#F4EEE1"
        android:pathData="M44,48 a4,4 0 0 1 4,-4 h12 a4,4 0 0 1 4,4 v14 a4,4 0 0 1 -4,4 h-12 a4,4 0 0 1 -4,-4 z" />
</vector>
