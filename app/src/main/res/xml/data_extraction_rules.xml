<?xml version="1.0" encoding="utf-8"?><!--
    Nothing leaves the device by backup or by transfer. The reasoning is in
    AndroidManifest.xml: what would come back is not only the pantry but the
    sync bookkeeping that decides how the next session reconciles it.

    android:allowBackup="false" covers cloud backup; device-to-device transfer
    is a separate channel that only these rules switch off.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
